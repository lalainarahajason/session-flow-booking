<?xml version="1.0"?>
<ruleset name="Session Flow Bookings"><description>WordPress standards for product sources.</description>
<file>session-flow-bookings.php</file><file>uninstall.php</file><file>src</file><file>templates</file>
<arg name="extensions" value="php"/><arg value="s"/>
<rule ref="WordPress"/>
<config name="minimum_supported_wp_version" value="6.8"/>
<rule ref="WordPress.WP.I18n"><properties><property name="text_domain" type="array"><element value="session-flow-bookings"/></property></properties></rule>
<rule ref="WordPress.WP.Capabilities"><properties><property name="custom_capabilities" type="array"><element value="booking_manage"/><element value="booking_manage_settings"/></property></properties></rule>
</ruleset>
